{
  "name": "@loncothad/dsh-media-gen",
  "description": "Shared media-generation assembly: transitions, harvesting, and router surfaces.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./catalog-wire": {
      "types": "./lib/types/catalog-wire.d.ts",
      "default": "./lib/catalog-wire.js"
    }
  },
  "files": [
    "lib",
    "src",
    "locale"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "node ../../tools/typecheck.mjs",
    "build": "node ../../tools/build.mjs --package support/media-gen"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loncothad/dsh-plugins.git",
    "directory": "support/media-gen"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/loncothad/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/loncothad/dsh-plugins/issues"
  },
  "types": "lib/types/index.d.ts",
  "author": "loncothad",
  "dependencies": {
    "ajv": "8.20.0",
    "ipaddr.js": "2.5.0",
    "undici": "8.11.2",
    "@loncothad/dsh-plugin-runtime": "workspace:*"
  }
}
