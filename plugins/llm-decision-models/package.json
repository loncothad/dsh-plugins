{
  "name": "@loncothad/dsh-llm-decision-models",
  "description": "System One decision models (TypeSafe Jev and OpenRouter) behind the decision_ask tool.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "node ../../tools/typecheck.mjs",
    "build": "node ../../tools/build.mjs --package plugins/llm-decision-models"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loncothad/dsh-plugins.git",
    "directory": "plugins/llm-decision-models"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@loncothad/dsh-plugin-runtime": "workspace:*",
    "@loncothad/dsh-media-gen": "workspace:*",
    "@loncothad/dsh-decision-core": "workspace:*"
  },
  "homepage": "https://github.com/loncothad/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/loncothad/dsh-plugins/issues"
  },
  "types": "lib/types/index.d.ts",
  "author": "loncothad"
}
